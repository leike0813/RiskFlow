      "payload": {
        "kind": "detail",
        "agentTaskRef": { "$result": "start-knowledge-task", "path": ["agentTaskRef"] }
      },
      "expectedTerminalStatus": "completed",
      "requiredReferences": [["resultRef", "candidateRef"]]

  "standard": {
    "code": "GB 50911-2013",
    "title": "城市轨道交通工程监测技术规范",
    "standardKind": "国家规范",
    "publisher": "中华人民共和国住房和城乡建设部、中华人民共和国国家质量监督检验检疫总局联合发布；中国建筑工业出版社出版",
    "announcement": "住房城乡建设部公告第 141 号",
    "issuedOn": "2013-09-06",
    "effectiveFrom": "2014-05-01",
    "mandatoryClauses": ["3.1.1", "9.1.1", "9.1.5"]
  },
  "clauses": [
    {
      "clauseNumber": "3.1.1",
      "pdfPage": 16,
      "kind": "适用条件",
      "mandatory": true,
      "quote": "城市轨道交通地下工程应在施工阶段对支护结构、周围岩土体及周边环境进行监测。"
    },
    {
      "clauseNumber": "3.2.5",
      "pdfPage": 19,
      "kind": "适用条件",
      "mandatory": false,
      "quote": "监测范围应根据基坑设计深度、隧道埋深和断面尺寸、施工工法、支护结构形式、地质条件、周边环境条件等综合确定，并应包括主要影响区和次要影响区。"
    },
    {
      "clauseNumber": "3.3.5",
      "pdfPage": 21,
      "kind": "适用条件",
      "mandatory": false,
      "quote": "工程监测等级可按表 3.3.5 划分，并应根据当地经验结合地质条件复杂程度进行调整。"
    },
    {
      "clauseNumber": "4.2.2",
      "pdfPage": 23,
      "tableNumber": "表 4.2.2",
      "tableContinuedOnPdfPage": 24,
      "kind": "指标项",
      "mandatory": false,
      "quote": "盾构法隧道管片结构和周围岩土体监测项目应根据表 4.2.2 选择。",
      "note": "表 4.2.2 中「地表沉降」在一级、二级、三级工程监测等级下均为应测项目。"
    },
    {
      "clauseNumber": "9.1.1",
      "pdfPage": 61,
      "kind": "预警",
      "mandatory": true,
      "quote": "城市轨道交通工程监测应根据工程特点、监测项目控制值、当地施工经验等制定监测预警等级和预警标准。"
    },
    {
      "clauseNumber": "9.1.3",
      "pdfPage": 61,
      "kind": "评分阈值",
      "mandatory": false,
      "quote": "监测项目控制值应按监测项目的性质分为变形监测控制值和力学监测控制值。变形监测控制值应包括变形监测数据的累计变化值和变化速率值；力学监测控制值宜包括力学监测数据的最大值和最小值。"
    },
    {
      "clauseNumber": "9.1.5",
      "pdfPage": 62,
      "kind": "预警",
      "mandatory": true,
      "quote": "城市轨道交通工程施工过程中，当监测数据达到预警标准时，必须进行警情报送。"
    },
    {
      "clauseNumber": "9.2.2",
      "pdfPage": 62,
      "tableNumber": "表 9.2.2-2",
      "tablePdfPage": 65,
      "kind": "评分阈值",
      "mandatory": false,
      "quote": "盾构法隧道管片结构竖向位移、净空收敛和地表沉降控制值应根据工程地质条件、隧道设计参数、工程监测等级及当地工程经验等确定，当无地方经验时，可按表 9.2.2-1 和表 9.2.2-2 确定。"
    }
  ],
  "indicatorItems": [
